{
  "name": "exo-express",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @exo/api --filter @exo/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @exo/api prisma:generate",
    "db:migrate": "pnpm --filter @exo/api prisma:migrate",
    "db:seed": "pnpm --filter @exo/api prisma:seed"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}