generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATIONS
  DISPATCHER
  DEPOT_AGENT
  COURIER
  MERCHANT
  ACCOUNTANT
  SUPPORT
}

enum ShipmentStatus {
  CREATED
  PICKUP_ASSIGNED
  PICKED_UP
  AT_DEPOT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURN_REQUESTED
  RETURNING
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COLLECTED
  SETTLED
  REVERSED
}

enum AssignmentStatus {
  ACTIVE
  REASSIGNED
  UNASSIGNED
}

enum CodStatus {
  COLLECTED
  REVERSED
}

enum CodTransactionType {
  COLLECTION
  REVERSAL
  ADJUSTMENT
}

enum CodPaymentMethod {
  CASH
  CARD
  MOBILE_PAYMENT
  BANK_TRANSFER
}

enum DeliveryOutcome {
  DELIVERED
  RECIPIENT_UNAVAILABLE
  REFUSED
  INCORRECT_ADDRESS
  RESCHEDULED
  RETURNED
}

enum ProofOfDeliveryType {
  PHOTO
  SIGNATURE
  OTP
}

enum SettlementStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum InventoryStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions          Session[]
  merchantUsers     MerchantUser[]
  shipmentsAsCourier Shipment[] @relation("CourierShipments")
  shipmentEvents    ShipmentEvent[]
  auditLogs         AuditLog[]
  assignmentsGiven  ShipmentAssignment[] @relation("AssignmentActor")
  assignmentsOwned  ShipmentAssignment[] @relation("AssignmentCourier")
  codCollections    CodCollection[] @relation("CodCollector")
  codReversals      CodCollection[] @relation("CodReverser")
  codTransactions   CodTransaction[] @relation("CodTransactionActor")
  proofsCollected   ProofOfDelivery[] @relation("PodCollector")
  settlementsCreated MerchantSettlement[] @relation("SettlementCreator")
  settlementsApproved MerchantSettlement[] @relation("SettlementApprover")
  settlementsPaid   MerchantSettlement[] @relation("SettlementPayer")
  settlementsCancelled MerchantSettlement[] @relation("SettlementCanceller")
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String   @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}

model Merchant {
  id           String   @id @default(uuid())
  businessName String
  contactName  String
  phone        String
  email        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users       MerchantUser[]
  shipments   Shipment[]
  settlements MerchantSettlement[]
  inventory   Inventory[]
  complaints  Complaint[]
}

model MerchantUser {
  id         String   @id @default(uuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([merchantId, userId])
}

model Zone {
  id          String   @id @default(uuid())
  name        String
  city        String   @default("Casablanca")
  deliveryFee Decimal  @db.Decimal(10, 2)
  returnFee   Decimal  @default(5) @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shipments   Shipment[]
  tariffs     ZoneTariff[]
  inventory   Inventory[]
}

model ZoneTariff {
  id        String   @id @default(uuid())
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  label     String
  price     Decimal  @db.Decimal(10, 2)
  returnFee Decimal  @default(5) @db.Decimal(10, 2)
  isDefault Boolean  @default(false)
  validFrom DateTime @default(now())
  validTo   DateTime?
  createdAt DateTime @default(now())

  @@index([zoneId, validFrom])
}

model Shipment {
  id                   String         @id @default(uuid())
  trackingNumber       String         @unique
  merchantId           String
  merchant             Merchant       @relation(fields: [merchantId], references: [id])
  recipientName        String
  recipientPhone       String
  address              String
  city                 String
  zoneId               String
  zone                 Zone           @relation(fields: [zoneId], references: [id])
  status               ShipmentStatus @default(CREATED)
  codAmount            Decimal        @default(0) @db.Decimal(10, 2)
  deliveryFee          Decimal        @db.Decimal(10, 2)
  returnFee            Decimal        @default(5) @db.Decimal(10, 2)
  courierId            String?
  courier              User?          @relation("CourierShipments", fields: [courierId], references: [id])
  paymentStatus        PaymentStatus  @default(PENDING)
  deliveryAttemptCount Int            @default(0)
  deliveryOutcome      DeliveryOutcome?
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  events ShipmentEvent[]
  assignments ShipmentAssignment[]
  codCollection CodCollection?
  proofOfDelivery ProofOfDelivery?
  settlementItems SettlementItem[]
  complaints Complaint[]

  @@index([merchantId, status])
  @@index([courierId, status])
  @@index([createdAt])
}

model ShipmentAssignment {
  id           String           @id @default(uuid())
  shipmentId   String
  shipment     Shipment         @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  courierId    String
  courier      User             @relation("AssignmentCourier", fields: [courierId], references: [id])
  assignedById String
  assignedBy   User             @relation("AssignmentActor", fields: [assignedById], references: [id])
  status       AssignmentStatus @default(ACTIVE)
  note         String?
  assignedAt   DateTime         @default(now())
  endedAt      DateTime?

  @@index([shipmentId, assignedAt])
  @@index([courierId, status])
  @@index([assignedById, assignedAt])
}

model CodTransaction {
  id            String            @id @default(uuid())
  collectionId  String
  collection    CodCollection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  type          CodTransactionType
  amount        Decimal           @db.Decimal(12, 2)
  actorId       String?
  actor         User?             @relation("CodTransactionActor", fields: [actorId], references: [id])
  note          String?
  createdAt     DateTime          @default(now())

  @@index([collectionId, createdAt])
}

model CodCollection {
  id           String          @id @default(uuid())
  shipmentId   String          @unique
  shipment     Shipment        @relation(fields: [shipmentId], references: [id])
  courierId    String
  courier      User            @relation("CodCollector", fields: [courierId], references: [id])
  amount       Decimal         @db.Decimal(12, 2)
  paymentMethod CodPaymentMethod @default(CASH)
  reference    String          @unique
  status       CodStatus       @default(COLLECTED)
  collectedAt  DateTime        @default(now())
  reversedAt   DateTime?
  reversedById String?
  reversedBy   User?           @relation("CodReverser", fields: [reversedById], references: [id])
  reversalNote String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  transactions CodTransaction[]

  @@index([courierId, collectedAt])
  @@index([status, collectedAt])
}

model ProofOfDelivery {
  id           String             @id @default(uuid())
  shipmentId   String             @unique
  shipment     Shipment           @relation(fields: [shipmentId], references: [id])
  type         ProofOfDeliveryType
  signatureRef String?
  photoRef     String?
  otpCode      String?
  collectedById String
  collectedBy  User               @relation("PodCollector", fields: [collectedById], references: [id])
  note         String?
  createdAt    DateTime           @default(now())
}

model SettlementItem {
  id           String            @id @default(uuid())
  settlementId String
  settlement   MerchantSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  shipmentId   String
  shipment     Shipment          @relation(fields: [shipmentId], references: [id])
  codAmount    Decimal           @db.Decimal(12, 2)
  deliveryFee  Decimal           @default(0) @db.Decimal(12, 2)
  returnFee    Decimal           @default(0) @db.Decimal(12, 2)
  createdAt    DateTime          @default(now())

  @@unique([settlementId, shipmentId])
  @@index([shipmentId])
}

model ShipmentEvent {
  id         String         @id @default(uuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?          @relation(fields: [actorId], references: [id])
  fromStatus ShipmentStatus?
  toStatus   ShipmentStatus
  note       String?
  latitude   Decimal?       @db.Decimal(10, 7)
  longitude  Decimal?       @db.Decimal(10, 7)
  createdAt  DateTime       @default(now())

  @@index([shipmentId, createdAt])
}

model MerchantSettlement {
  id           String           @id @default(uuid())
  merchantId   String
  merchant     Merchant         @relation(fields: [merchantId], references: [id])
  periodStart  DateTime
  periodEnd    DateTime
  grossCod     Decimal          @db.Decimal(12, 2)
  deliveryFees Decimal          @db.Decimal(12, 2)
  returnFees   Decimal          @default(0) @db.Decimal(12, 2)
  adjustments  Decimal          @default(0) @db.Decimal(12, 2)
  netPayable   Decimal          @db.Decimal(12, 2)
  status       SettlementStatus @default(PENDING)
  reference    String           @unique
  createdById  String?
  createdBy    User?            @relation("SettlementCreator", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?            @relation("SettlementApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  paidById     String?
  paidBy       User?            @relation("SettlementPayer", fields: [paidById], references: [id])
  paidAt       DateTime?
  cancelledById String?
  cancelledBy  User?            @relation("SettlementCanceller", fields: [cancelledById], references: [id])
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  items SettlementItem[]

  @@index([merchantId, status])
  @@index([status, createdAt])
}

model Inventory {
  id           String   @id @default(uuid())
  merchantId   String
  merchant     Merchant   @relation(fields: [merchantId], references: [id])
  zoneId       String?
  zone         Zone?      @relation(fields: [zoneId], references: [id])
  productName  String
  quantity     Int        @default(0)
  reserved     Int        @default(0)
  alertThreshold Int      @default(5)
  isActive     Boolean   @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([merchantId, zoneId, productName])
  @@index([merchantId])
  @@index([zoneId])
}

model Complaint {
  id               String   @id @default(uuid())
  shipmentId       String
  shipment         Shipment @relation(fields: [shipmentId], references: [id])
  merchantId       String
  merchant         Merchant @relation(fields: [merchantId], references: [id])
  customerName     String
  customerPhone    String
  customerEmail    String?
  type             String   // e.g., "DAMAGED", "LATE", "WRONG_ITEM", "OTHER"
  status           String   @default("OPEN") // OPEN, IN_REVIEW, RESOLVED, CLOSED
  description      String
  assignedTo       String?  // User ID
  resolvedAt       DateTime?
  resolutionNotes  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([shipmentId])
  @@index([status])
  @@index([assignedTo])
}