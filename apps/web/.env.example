# Public configuration for the EXO EXPRESS dashboard build.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle at `next build`
# time. Never put a secret, token or database URL in this file.
#
# Set this to the public HTTPS base URL of the Fastify API before building.
# The API must also allow the dashboard origin in CORS_ORIGINS.
NEXT_PUBLIC_API_URL=https://api.example.invalid

# Optional deployment sub-path. Leave EMPTY for a root deployment (Surge,
# local preview, https://exoexpress.surge.sh/). Set it to the directory that
# serves the dashboard when hosting it under a sub-path, without a trailing
# slash, for example:
#
#   NEXT_PUBLIC_BASE_PATH=/dashboard
#
# for https://www.exoexpress.ma/dashboard/. The root public website is not
# affected: only the generated assets and routes are prefixed.
NEXT_PUBLIC_BASE_PATH=
