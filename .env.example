# EXO EXPRESS — Environment Variables
# 
# NOTE: Never commit actual .env files. This file is safe to commit as it contains
# only placeholder values. See .gitignore for exclusions.
#
# 1. Copy this file to `.env` in each app directory
# 2. Replace placeholder values with your actual credentials
# 3. Never push `.env` files to GitHub

# =============================================================================
# API Server (.env — apps/api/.env)
# =============================================================================

# Database
DATABASE_URL=postgresql://exo_express:password@localhost:5432/exo_express

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-minimum-32-characters
JWT_EXPIRES_IN=1d

# CORS
CORS_ORIGIN=http://localhost:3000

# Optional: Payment gateways
# STRIPE_KEY=pk_test_your_stripe_key_here

# =============================================================================
# Web App (.env — apps/web/.env)
# =============================================================================

# API base URL (required — the web app will fail to load data if missing)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Base path for sub-path deployment (leave empty for root deployment)
# NEXT_PUBLIC_BASE_PATH=/dashboard

# =============================================================================
# Courier App (.env — apps/courier/.env, if needed)
# =============================================================================

# Expo-specific env vars (if needed)
EXPO_PUBLIC_API_URL=http://localhost:3001